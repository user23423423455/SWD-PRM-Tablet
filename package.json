{
  "name": "swd-prm-tablet-kmcr-pl-en",
  "version": "2.0.0",
  "description": "SWD PRM KMCR tablet with Polish and English language options",
  "main": "main.cjs",
  "author": "Nachash",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pl.nachash.swdprm.kmcr.plen",
    "publish": null,
    "productName": "SWD PRM Tablet KMCR PL-EN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "KMCR.html",
      "main.cjs",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "SWD-PRM-Tablet-KMCR-PL-EN-Portable.exe"
    }
  }
}
